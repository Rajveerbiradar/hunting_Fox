# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Your live site address, e.g. https://hunting-fox.vercel.app (used in resume links)
NEXT_PUBLIC_SITE_URL=

# Apify accounts: easiest is to add them in /admin → API keys. These env tokens are optional extras.
APIFY_TOKENS=me:apify_api_xxx,friend1:apify_api_yyy
# Optional: force "full" or "lean" (can also be set in /admin). Default: lean when pooled credit < $5
SCAN_MODE=

# AI: easiest is /admin → API keys → Add a provider (any OpenAI-SDK-compatible API, tested before saving).
# These are an optional fallback provider. AI_BASE_URL defaults to Anthropic's OpenAI-compatible endpoint.
AI_BASE_URL=https://api.anthropic.com/v1/
AI_API_KEY=
AI_MODEL=claude-haiku-5-5

# Optional emails ("your job is ready"). Leave empty to skip; set NEXT_PUBLIC_EMAILS=on to show the settings.
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_EMAILS=

# Who can open /admin and approve students (your Google sign-in email). Comma separated.
ADMIN_EMAILS=

# Encrypts keys saved in /admin. Any long random text; never change it once keys are saved.
KEYS_SECRET=

# Protects /api/cron (Vercel sends it automatically when set in project env)
CRON_SECRET=
